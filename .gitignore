# OS
.DS_Store
Thumbs.db

# Dependencies
node_modules/

# Logs
*.log
logs/
sessions

# Secrets (host credentials, etc.)
.claude/secrets/*
!.claude/secrets/*.example

# Scheduled-tasks runtime lock (Claude Code /schedule and /loop skills)
.claude/scheduled_tasks.lock

# Stray SQLite files — leaked in from other projects' Drizzle/sqlite commands
# running in Sardaukar's CWD. Sardaukar itself has no database.
*.db

# Playwright MCP
.playwright-mcp/

# Playwright screenshots — local debugging / verification, not committed
tests/screenshots/

# Safety net: stray image files at the Sardaukar repo root.
# Sardaukar has no legitimate images at root — anything here is a Playwright leak
# (SWE called browser_take_screenshot without an absolute path, MCP resolved against
# its CWD which is Sardaukar's root). The per-project Playwright lifecycle in
# swe-agent.md is the real fix; this catches anything that slips through.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
