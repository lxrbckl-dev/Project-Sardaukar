# SSH Host Credentials
# Copy this file to hosts.yml (gitignored) and fill in your actual hosts.
# Agents read from hosts.yml to look up SSH connection details.
#
# DO NOT commit hosts.yml — it's gitignored for a reason.

hosts:
  # Friendly alias the user references in chat (e.g., "ssh into nas")
  nas:
    address: 192.168.1.50
    port: 22
    user: admin
    password: "your-password-here"

  pi-server:
    address: 192.168.1.51
    port: 22
    user: pi
    password: "another-password"

  # Add as many as you want
