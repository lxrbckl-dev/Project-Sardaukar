# iOS Deployment Configuration
# Copy this file to ios.yml (gitignored) and fill in your values.
# Agents read ios.yml when Alex asks to build/install an iOS app on his phone.
#
# DO NOT commit ios.yml — it's gitignored.

# Apple Developer Team ID (https://developer.apple.com/account → Membership)
team_id: "XXXXXXXXXX"

# Reverse-DNS bundle ID prefix for your apps (e.g., "dev.example" → "dev.example.MyApp")
bundle_id_prefix: "dev.example"

# iPhone UDID for `xcodebuild -destination 'platform=iOS,id=<udid>'`
# Discover via: xcodebuild -showdestinations -scheme <Scheme>
iphone_udid: "00000000-0000000000000000"

# devicectl device identifier for `xcrun devicectl device install/launch`
# Discover via: xcrun devicectl list devices
devicectl_id: "00000000-0000-0000-0000-000000000000"
