<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sardaukar.ctrl</string>
    <key>ProgramArguments</key>
    <array>
        <string>__NPX_PATH__</string>
        <string>@bulletproof-sh/ctrl-daemon@latest</string>
        <string>--port</string>
        <string>3871</string>
        <string>--host</string>
        <string>0.0.0.0</string>
        <string>--no-open</string>
        <string>--no-tui</string>
        <string>--share</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__HOME_DIR__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/logs/ctrl-launch.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/logs/ctrl-launch.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__NODE_BIN_DIR__:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>__HOME_DIR__</string>
    </dict>
</dict>
</plist>
