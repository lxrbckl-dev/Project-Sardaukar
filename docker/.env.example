# Project Sardaukar — Environment Configuration
# Copy this to .env and fill in your values.

# Webhook secrets — must match what you set in GitHub org webhook settings
# Generate with: openssl rand -hex 32
HERZOG_WEBHOOK_SECRET=CHANGE_ME
LXRBCKL_WEBHOOK_SECRET=CHANGE_ME

# SWE agent count — max concurrent SWE subagents TPM can spawn (default: 3)
SWE_AGENT_COUNT=3
